<header class="pl ovf" {% if section.settings.bg %}style="background-image:url({{ section.settings.bg | image_url: width: 2000 }})"{% endif %}>
  <div class="wrap ahero">
    <div class="stack">
      <span class="lab"><i></i>{{ section.settings.eyebrow }}</span>
      <h1 class="bl md">{{ section.settings.heading }}</h1>
      <p class="copy" style="font-size:17px">{{ section.settings.text }}</p>
      <div class="facts" style="display:flex;flex-wrap:wrap;gap:10px 26px">
        {%- if section.settings.fact1 != blank -%}<span class="note ink">{{ section.settings.fact1 }}</span>{%- endif -%}
        {%- if section.settings.fact2 != blank -%}<span class="note ink">{{ section.settings.fact2 }}</span>{%- endif -%}
      </div>
      {%- if section.settings.cta != blank -%}
        <div class="btns"><a class="btn solid" href="{{ section.settings.url | default: '#appTop' }}">{{ section.settings.cta }}</a></div>
      {%- endif -%}
    </div>
    <div class="shot">
      {%- if section.settings.image -%}<img src="{{ section.settings.image | image_url: width: 1600 }}" alt="{{ section.settings.heading | escape }}" width="1600" height="1067">
      {%- else -%}<img src="{{ 'apparel-hero.jpg' | asset_url }}" alt="{{ section.settings.heading | escape }}" width="1536" height="1024">{%- endif -%}
    </div>
  </div>
  {%- if section.settings.collection != blank -%}
    <div class="wrap ahero-row">
      <div class="grid three">
        {%- for product in section.settings.collection.products limit: section.settings.count -%}
          {%- render 'product-card', card_product: product -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</header>
{% schema %}
{
  "name": "Apparel hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Counter Culture Conflict apparel" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Conflict apparel" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Tees, hoodies, work shirts and caps from the show, printed when you order." },
    { "type": "text", "id": "fact1", "label": "Fact 1", "default": "Made to order" },
    { "type": "text", "id": "fact2", "label": "Fact 2", "default": "Free shipping" },
    { "type": "text", "id": "cta", "label": "Button label", "default": "Shop the first run" },
    { "type": "url", "id": "url", "label": "Button link" },
    { "type": "image_picker", "id": "image", "label": "Garment photo" },
    { "type": "image_picker", "id": "bg", "label": "Background" },
    { "type": "collection", "id": "collection", "label": "Show products from", "info": "Leave empty on the apparel page itself" },
    { "type": "range", "id": "count", "label": "Products shown", "min": 3, "max": 6, "step": 3, "default": 3 }
  ],
  "presets": [{ "name": "Apparel hero" }]
}
{% endschema %}
