{%- liquid
  assign clip = section.settings.clip
  if clip != blank
    unless clip contains 'http'
      assign clip = clip | file_url
    endunless
  endif
-%}
<header class="mh">
  <div class="mh-bg" aria-hidden="true"><div class="hs-plate" style="background-image:url({{ 'pl-plain.jpg' | asset_url }})"></div><div class="gridbg" style="--gx:74%;--gy:50%"></div></div>
  <div class="wrap split mhero" style="align-items:center">
    <div class="stack">
      <span class="lab"><i></i>{{ section.settings.place }}</span>
      <h1 class="bl">{{ section.settings.heading }}</h1>
      <p class="big" style="max-width:26ch">{{ section.settings.lede }}</p>
      <p class="copy">{{ section.settings.text }}</p>
      <div class="btns">
        {%- if section.settings.url != blank -%}<a class="btn solid" href="{{ section.settings.url }}">{{ section.settings.cta }}</a>{%- endif -%}
        {%- if section.settings.url2 != blank -%}<a class="btn" href="{{ section.settings.url2 }}" target="_blank" rel="noopener">{{ section.settings.cta2 }}</a>{%- endif -%}
      </div>
      <div class="social">
        {%- for b in section.blocks -%}<a class="ib2" href="{{ b.settings.url }}" aria-label="{{ b.settings.name }}" target="_blank" rel="noopener">{{ b.settings.name | slice: 0, 2 }}</a>{%- endfor -%}
      </div>
    </div>
    <div class="hs-frame" style="max-width:520px;justify-self:end;width:100%">
      <div class="hs-bar"><span class="lab"><i></i>{{ section.settings.caption }}</span></div>
      <div class="hs-screen">
        {%- if clip != blank -%}<video class="on" src="{{ clip }}" {% if section.settings.poster %}poster="{{ section.settings.poster | image_url: width: 1000 }}"{% endif %} muted loop playsinline></video>
        {%- elsif section.settings.poster -%}<img src="{{ section.settings.poster | image_url: width: 1000 }}" alt="">{%- endif -%}
      </div>
    </div>
  </div>
</header>
{% schema %}
{
  "name": "Person hero",
  "settings": [
    { "type": "text", "id": "place", "label": "Eyebrow", "default": "Omaha, Nebraska" },
    { "type": "text", "id": "heading", "label": "Name", "default": "Murphy" },
    { "type": "text", "id": "lede", "label": "Lede", "default": "Laser engraver, Omaha, Nebraska. Host of Counter Culture Conflict." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Every engraved item in this store was set up, run and checked by Murphy himself on an industrial fiber laser, and when the machine is off he is on the mic." },
    { "type": "text", "id": "clip", "label": "Video file", "default": "v-murph.mp4" },
    { "type": "image_picker", "id": "poster", "label": "Poster image" },
    { "type": "text", "id": "caption", "label": "Frame caption", "default": "Murphy, off shift" },
    { "type": "text", "id": "cta", "label": "Button label", "default": "Shop his work" },
    { "type": "url", "id": "url", "label": "Button link" },
    { "type": "text", "id": "cta2", "label": "Second button label", "default": "Watch the show" },
    { "type": "url", "id": "url2", "label": "Second button link" }
  ],
  "blocks": [
    { "type": "social", "name": "Social link", "settings": [
      { "type": "text", "id": "name", "label": "Name", "default": "Instagram" },
      { "type": "url", "id": "url", "label": "Link" }
    ]}
  ],
  "presets": [{ "name": "Person hero" }]
}
{% endschema %}
