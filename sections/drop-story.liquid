{{ 'apparel.css' | asset_url | stylesheet_tag }}
<section class="wrap sec" id="{{ section.settings.anchor | default: 'drop' }}">
  <div class="drop">
    <div class="drop-art rv">
      {%- if section.settings.tag != blank -%}<span class="tag hi">{{ section.settings.tag }}</span>{%- endif -%}
      {%- if section.settings.art_1 -%}
        <img src="{{ section.settings.art_1 | image_url: width: 1400 }}" alt="{{ section.settings.art_1.alt | default: section.settings.heading | escape }}" width="1400" height="1400" loading="lazy">
      {%- endif -%}
      {%- if section.settings.art_2 -%}
        <img src="{{ section.settings.art_2 | image_url: width: 1400 }}" alt="{{ section.settings.art_2.alt | escape }}" width="1400" height="1400" loading="lazy">
      {%- endif -%}
    </div>
    <div class="stack rv">
      <span class="lab"><i></i>{{ section.settings.eyebrow }}</span>
      <h2 class="h2">{{ section.settings.heading }}</h2>
      <p class="copy" style="font-size:17px">{{ section.settings.text }}</p>
      {%- if section.blocks.size > 0 -%}
        <ul class="drop-pts">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}><b>{{ forloop.index | prepend: '0' | slice: -2, 2 }}</b><span>{{ block.settings.text }}</span></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Drop story",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor", "default": "drop" },
    { "type": "text", "id": "tag", "label": "Tag", "default": "Drop 01" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The designs" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The first run" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "image_picker", "id": "art_1", "label": "Artwork" },
    { "type": "image_picker", "id": "art_2", "label": "Artwork, shown on hover" }
  ],
  "blocks": [
    { "type": "point", "name": "Point", "settings": [ { "type": "text", "id": "text", "label": "Text" } ] }
  ],
  "presets": [{ "name": "Drop story", "blocks": [{"type":"point"},{"type":"point"},{"type":"point"}] }]
}
{% endschema %}
