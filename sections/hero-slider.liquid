<section class="hs" id="hs" aria-roledescription="carousel" aria-label="{{ section.settings.label | escape }}" tabindex="-1">
  <div class="hs-bg" aria-hidden="true">
    <div class="hs-plate" {% if section.settings.plate %}style="background-image:url({{ section.settings.plate | image_url: width: 1800 }})"{% endif %}></div>
    <img alt=""><img alt="">
  </div>
  <div class="hs-in">
    <div>
      <span class="lab"><i></i>{{ section.settings.label }}</span>
      <div class="hs-texts">
        {%- for block in section.blocks -%}
          <article class="hs-t" aria-hidden="true" {{ block.shopify_attributes }}>
            {%- if forloop.first -%}<h1 class="bl">{{ block.settings.heading }}</h1>{%- else -%}<h2 class="bl">{{ block.settings.heading }}</h2>{%- endif -%}
            <p class="copy">{{ block.settings.text }}</p>
            {%- if block.settings.cta != blank -%}<div class="btns"><a class="btn solid" href="{{ block.settings.url }}">{{ block.settings.cta }}</a></div>{%- endif -%}
          </article>
        {%- endfor -%}
      </div>
      <div class="hs-ctl">
        <div class="segs">{%- for block in section.blocks -%}<button class="seg" type="button" aria-label="Slide {{ forloop.index }}"><i></i></button>{%- endfor -%}</div>
        <button class="xb" data-prev type="button">Prev</button>
        <button class="xb" data-next type="button">Next</button>
        <button class="xb" data-pause type="button">Pause</button>
      </div>
    </div>
    <div class="hs-frame">
      <div class="hs-bar"><span class="lab"><i></i>{{ section.settings.bar }}</span><span class="lab"><span id="hsMat"></span> &nbsp;&nbsp; <span id="hsCount" style="color:#fff"></span></span></div>
      <div class="hs-screen">
        {%- for block in section.blocks -%}
          {%- liquid
            assign clip = block.settings.clip
            if clip != blank
              unless clip contains 'http'
                assign clip = clip | file_url
              endunless
            endif
          -%}
          <video class="manual" {% if clip != blank %}src="{{ clip }}"{% endif %}
            {% if block.settings.poster %}poster="{{ block.settings.poster | image_url: width: 900 }}" data-p="{{ block.settings.poster | image_url: width: 900 }}"{% endif %}
            data-mat="{{ block.settings.material | escape }}" muted loop playsinline></video>
        {%- endfor -%}
      </div>
    </div>
    <div class="hs-thumbs" role="group" aria-label="Choose a clip">
      {%- for block in section.blocks -%}
        <button class="hs-th" type="button" aria-label="{{ block.settings.heading | escape }}">
          {%- if block.settings.poster -%}<img src="{{ block.settings.poster | image_url: width: 300 }}" alt="">{%- endif -%}
        </button>
      {%- endfor -%}
    </div>
  </div>
  <div class="hs-facts"><div class="wrap">
    <div><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg><span class="lab">Shipping time</span><b>{{ settings.fact_ship_time }}</b></div>
    <div><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 6h11v10H2zM13 9h5l3 3v4h-8z"/><circle cx="6.5" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg><span class="lab">US shipping</span><b>{{ settings.fact_ship_us }}</b></div>
    <div><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20l4-1 11-11-3-3L5 16zM14 7l3 3"/></svg><span class="lab">Add a name</span><b>{{ settings.fact_name }}</b></div>
    <div><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18"/></svg><span class="lab">Canada</span><b>{{ settings.fact_ca }}</b></div>
  </div></div>
</section>

{% schema %}
{
  "name": "Hero slider",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "label", "label": "Eyebrow", "default": "Laser engraving  /  Omaha, Nebraska" },
    { "type": "text", "id": "bar", "label": "Clip caption", "default": "Murphy's bench" },
    { "type": "image_picker", "id": "plate", "label": "Background plate" }
  ],
  "blocks": [
    { "type": "slide", "name": "Slide", "settings": [
      { "type": "text", "id": "material", "label": "Material label", "default": "Anodized aluminum" },
      { "type": "text", "id": "heading", "label": "Headline", "default": "Engraved into the metal" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "An industrial fiber laser does not just take the coating off. It cuts a deep, permanent engraving into the metal item itself." },
      { "type": "text", "id": "cta", "label": "Button label", "default": "Shop can lids" },
      { "type": "url", "id": "url", "label": "Button link" },
      { "type": "image_picker", "id": "poster", "label": "Still image" },
      { "type": "text", "id": "clip", "label": "Video file URL", "info": "Paste the file URL from Content > Files" }
    ]}
  ],
  "presets": [ { "name": "Hero slider", "blocks": [ {"type":"slide"}, {"type":"slide"}, {"type":"slide"} ] } ]
}
{% endschema %}
