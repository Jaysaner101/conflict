{%- liquid
  assign clip = section.settings.clip
  if clip != blank
    unless clip contains 'http'
      assign clip = clip | file_url
    endunless
  endif
-%}
<div class="seen" id="seen">
  {%- if section.settings.image -%}<img src="{{ section.settings.image | image_url: width: 2000 }}" alt="{{ section.settings.heading | escape }}">
  {%- else -%}<img src="{{ 'hero-poster.jpg' | asset_url }}" alt="{{ section.settings.heading | escape }}">{%- endif -%}
  {%- if clip != blank -%}<video class="manual" src="{{ clip }}" playsinline preload="none"></video>{%- endif -%}
  <div class="wrap seen-in"><div class="stack rv">
    <span class="lab"><i></i>{{ section.settings.eyebrow }}</span>
    <h2 class="bl sm">{{ section.settings.heading }}</h2>
    <p class="copy">{{ section.settings.text }}</p>
    <div class="btns">
      {%- if clip != blank -%}
        <button class="btn solid" data-play-inline type="button"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4l13 8-13 8z"/></svg>{{ section.settings.play_label }}</button>
      {%- endif -%}
      {%- if section.settings.url != blank -%}<a class="btn" href="{{ section.settings.url }}">{{ section.settings.cta }}</a>{%- endif -%}
    </div>
  </div></div>
  <div class="seen-ctl">
    <button class="xb" data-sp type="button">Pause</button><button class="xb" data-sm type="button">Sound on</button>
    <button class="xb" data-sf type="button">Fullscreen</button><button class="xb" data-sx type="button">Close</button>
  </div>
</div>
{% schema %}
{
  "name": "As seen on",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "clip", "label": "Video file URL", "info": "Paste from Content > Files" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "As seen on" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The show behind the shop" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Murphy hosts Counter Culture Conflict on the Counter Culture Inc network." },
    { "type": "text", "id": "play_label", "label": "Play button label", "default": "Play the title sequence" },
    { "type": "text", "id": "cta", "label": "Second button label", "default": "The show" },
    { "type": "url", "id": "url", "label": "Second button link" }
  ],
  "presets": [{ "name": "As seen on" }]
}
{% endschema %}
