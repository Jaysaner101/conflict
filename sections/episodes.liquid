<div class="wrap sec">
  <div class="sh">
    <div class="stack-s"><span class="lab"><i></i>{{ section.settings.eyebrow }}</span><h2 class="bl sm">{{ section.settings.heading }}</h2></div>
    {%- if section.settings.url != blank -%}
      <a class="btn" href="{{ section.settings.url }}" target="_blank" rel="noopener">
        <svg class="ic yt" viewBox="0 0 28 20" aria-hidden="true"><rect width="28" height="20" rx="5"/><path d="M11 5.5v9l8-4.5z" fill="#fff"/></svg>{{ section.settings.cta }}</a>
    {%- endif -%}
  </div>
  {%- comment -%}
    With a playlist set and a YouTube key in Theme settings, episodes.js swaps
    these cards for the playlist's newest videos, so a new episode appears on
    its own. The blocks below stay as the fallback (no key, or YouTube down).
  {%- endcomment -%}
  {%- liquid
    assign pl = section.settings.playlist | strip
    if pl contains 'list='
      assign pl = pl | split: 'list=' | last | split: '&' | first
    endif
    assign live_feed = false
    if pl != blank and settings.yt_api_key != blank
      assign live_feed = true
    endif
  -%}
  <div class="eps{% if section.settings.shorts %} shorts{% endif %}"{% if live_feed %} data-playlist="{{ pl | escape }}" data-key="{{ settings.yt_api_key | escape }}" data-count="{{ section.settings.count }}" data-short="{{ section.settings.shorts }}"{% endif %}>
    {%- for block in section.blocks -%}
      <a class="ep{% if section.settings.shorts %} short{% endif %}" href="{{ block.settings.url }}" target="_blank" rel="noopener" {{ block.shopify_attributes }}>
        <div class="th">
          {%- if block.settings.thumb -%}<img src="{{ block.settings.thumb | image_url: width: 800 }}" alt="" loading="lazy">{%- endif -%}
          <span class="pb"><svg class="ic" viewBox="0 0 24 24"><path d="M7 4l13 8-13 8z"/></svg></span>
          {%- if block.settings.dur != blank -%}<span class="du">{{ block.settings.dur }}</span>{%- endif -%}
        </div>
        <div class="t">{{ block.settings.title }}</div>
        {%- if block.settings.meta != blank -%}<div class="m">{{ block.settings.meta }}</div>{%- endif -%}
      </a>
    {%- else -%}
      <p class="copy">Add episodes as blocks, or connect a YouTube app to fill this automatically.</p>
    {%- endfor -%}
  </div>
</div>
{%- if section.settings.playlist != blank and settings.yt_api_key != blank -%}<script src="{{ 'episodes.js' | asset_url }}" defer></script>{%- endif -%}
{% schema %}
{
  "name": "Episodes",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Full shows, straight from YouTube" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Latest episodes" },
    { "type": "checkbox", "id": "shorts", "label": "Show as Shorts (tall thumbnails)", "default": false },
    { "type": "text", "id": "cta", "label": "Button label", "default": "Full playlist" },
    { "type": "url", "id": "url", "label": "Button link" },
    { "type": "text", "id": "playlist", "label": "YouTube playlist (link or ID)", "info": "Fills this row with the playlist's newest videos automatically. Needs the YouTube key in Theme settings. The episodes below are used if YouTube can't be reached." },
    { "type": "range", "id": "count", "label": "Videos shown from the playlist", "min": 4, "max": 12, "step": 4, "default": 8 }
  ],
  "blocks": [
    { "type": "episode", "name": "Episode", "settings": [
      { "type": "image_picker", "id": "thumb", "label": "Thumbnail" },
      { "type": "text", "id": "title", "label": "Title", "default": "Episode title" },
      { "type": "text", "id": "meta", "label": "Date and views" },
      { "type": "text", "id": "dur", "label": "Duration" },
      { "type": "url", "id": "url", "label": "Watch link" }
    ]}
  ],
  "presets": [{ "name": "Episodes", "blocks": [{"type":"episode"},{"type":"episode"},{"type":"episode"},{"type":"episode"}] }]
}
{% endschema %}
