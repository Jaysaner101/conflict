<div class="wrap sec" id="ways">
  <div class="sh rv">
    <div class="stack-s"><span class="lab"><i></i>{{ section.settings.eyebrow }}</span><h2 class="bl sm">{{ section.settings.heading }}</h2></div>
    <p class="copy" style="max-width:44ch">{{ section.settings.text }}</p>
  </div>
  <div class="ways rv">
    {%- for block in section.blocks -%}
      <div class="way{% if block.settings.accent %} hi{% endif %}" {{ block.shopify_attributes }}>
        <span class="lab">{%- if block.settings.accent -%}<svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l9 5-9 5-9-5zM3 13l9 5 9-5"/></svg>{%- else -%}<svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 8h14l-1 12H6zM9 8V7a3 3 0 0 1 6 0v1"/></svg>{%- endif -%}&nbsp;{{ block.settings.eyebrow }}</span>
        <h3 class="h2">{{ block.settings.heading }}</h3>
        <p class="copy">{{ block.settings.text }}</p>
        <ul>
          {%- assign yes = block.settings.yes | newline_to_br | split: '<br />' -%}
          {%- for line in yes -%}{%- assign l = line | strip -%}{%- if l != blank -%}
            <li><svg class="ic yes" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12.5l5 5L20 6.5"/></svg><span>{{ l }}</span></li>
          {%- endif -%}{%- endfor -%}
          {%- assign no = block.settings.no | newline_to_br | split: '<br />' -%}
          {%- for line in no -%}{%- assign l = line | strip -%}{%- if l != blank -%}
            <li><svg class="ic no" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"/></svg><span>{{ l }}</span></li>
          {%- endif -%}{%- endfor -%}
        </ul>
        {%- if block.settings.cta != blank -%}
          <div class="btns"><a class="btn solid" href="{{ block.settings.url }}">{%- if block.settings.accent -%}<svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l9 5-9 5-9-5zM3 13l9 5 9-5"/></svg>{%- else -%}<svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 8h14l-1 12H6zM9 8V7a3 3 0 0 1 6 0v1"/></svg>{%- endif -%}{{ block.settings.cta }}</a></div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Store or custom order",
  "max_blocks": 2,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Two ways to order" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The store, or a custom order" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "They are not the same thing. The online store is ready made items. Custom designs and logos are for larger orders only." }
  ],
  "blocks": [
    { "type": "way", "name": "Panel", "settings": [
      { "type": "checkbox", "id": "accent", "label": "Highlight this panel", "default": false },
      { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "For everyone" },
      { "type": "text", "id": "heading", "label": "Heading", "default": "The online store" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "Items Murphy has already engraved, in stock and ready to ship." },
      { "type": "textarea", "id": "yes", "label": "Included (one per line)", "default": "Ready made items, shipped in about 3 days.\nAdd a name for $5 each.\n$8 flat US shipping, free over $60." },
      { "type": "textarea", "id": "no", "label": "Not included (one per line)", "default": "No custom designs or logos.\nNo single custom items." },
      { "type": "text", "id": "cta", "label": "Button label", "default": "Shop the store" },
      { "type": "url", "id": "url", "label": "Button link" }
    ]}
  ],
  "presets": [{ "name": "Store or custom order", "blocks": [{"type":"way"},{"type":"way"}] }]
}
{% endschema %}
