{%- comment -%}
  The apparel range. Three across so a short range fills its rows, type chips
  once there is more than one kind of garment, and optional full-width photo
  tiles ("look" blocks) dropped in after a chosen card, so a handful of
  products reads as a collection rather than a sparse grid.
{%- endcomment -%}
{{ 'apparel.css' | asset_url | stylesheet_tag }}
{%- assign c = section.settings.collection -%}
<section class="wrap sec" id="{{ section.settings.anchor | default: 'range' }}">
  <div class="sh">
    <div class="stack-s"><span class="lab"><i></i>{{ section.settings.eyebrow }}</span><h2 class="h2">{{ section.settings.heading }}</h2></div>
    {%- if c != blank -%}<span class="lab" id="countLab">{{ c.products_count }} {% if c.products_count == 1 %}piece{% else %}pieces{% endif %}</span>{%- endif -%}
  </div>

  {%- comment -%} Types from the products a shopper can see; all_types also counts hidden products. {%- endcomment -%}
  {%- liquid
    assign types = ''
    if c != blank
      for pr in c.products limit: 24
        if pr.type != blank
          assign types = types | append: pr.type | append: '|'
        endif
      endfor
    endif
    assign types = types | split: '|' | uniq
  -%}
  {%- if types.size > 1 -%}
    <div class="chips ag-chips" id="typeChips" role="group" aria-label="Filter by type">
      <button type="button" class="chip" data-type="all" aria-pressed="true">All</button>
      {%- for t in types -%}
        <button type="button" class="chip" data-type="{{ t | handleize }}" aria-pressed="false">{{ t }}</button>
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- comment -%}
    Wide cards close the gap in the last row. Each wide card shows the
    product's two photos side by side and takes two cells, so at three across
    the first w3 cards go wide, and at two across the first w2 cards go full
    width. theme.js (wideCards) runs the same sum again when a type chip filters
    the grid.
  {%- endcomment -%}
  {%- liquid
    assign n_all = 0
    if c != blank
      assign n_all = c.products.size
      if n_all > 24
        assign n_all = 24
      endif
    endif
    assign r3 = n_all | modulo: 3
    assign w3 = 3 | minus: r3 | modulo: 3
    if n_all < 2
      assign w3 = 0
    endif
    assign w2 = n_all | modulo: 2
  -%}
<div class="grid ag-grid">
    {%- if c != blank -%}
      {%- for product in c.products limit: 24 -%}
        {%- liquid
          assign wide = ''
          if forloop.index <= w3
            assign wide = ' w3'
          endif
          if forloop.index <= w2
            assign wide = wide | append: ' w2'
          endif
        -%}
        {%- render 'product-card', card_product: product, card_class: wide -%}
        {%- assign n = forloop.index -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.after == n and block.settings.image -%}
            <a class="ag-look" href="{{ block.settings.url | default: '#' }}" {{ block.shopify_attributes }}>
              <img src="{{ block.settings.image | image_url: width: 2000 }}" alt="{{ block.settings.image.alt | escape }}" loading="lazy" width="2000" height="1000">
              <div class="stack-s">
                {%- if block.settings.eyebrow != blank -%}<span class="lab"><i></i>{{ block.settings.eyebrow }}</span>{%- endif -%}
                <h3 class="h3">{{ block.settings.heading }}</h3>
                {%- if block.settings.cta != blank -%}<span class="ul">{{ block.settings.cta }}</span>{%- endif -%}
              </div>
            </a>
          {%- endif -%}
        {%- endfor -%}
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Apparel range",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor", "default": "range" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Drop 01" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The range" },
    { "type": "collection", "id": "collection", "label": "Collection" }
  ],
  "blocks": [
    { "type": "look", "name": "Photo tile", "settings": [
      { "type": "image_picker", "id": "image", "label": "Photo" },
      { "type": "range", "id": "after", "label": "Show after card number", "min": 1, "max": 12, "step": 1, "default": 3 },
      { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
      { "type": "text", "id": "heading", "label": "Heading" },
      { "type": "text", "id": "cta", "label": "Link label" },
      { "type": "url", "id": "url", "label": "Link" }
    ]}
  ],
  "presets": [{ "name": "Apparel range" }]
}
{% endschema %}
