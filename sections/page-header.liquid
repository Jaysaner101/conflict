<header class="pghd" {% if section.settings.bg %}style="background-image:url({{ section.settings.bg | image_url: width: 2200 }})"{% endif %}>
  <div class="wrap pghd-in" style="position:relative;z-index:2">
    <div class="stack-s">
      <span class="lab"><i></i>{{ section.settings.eyebrow }}</span>
      <h1 class="bl md">{{ section.settings.heading | default: page.title }}</h1>
    </div>
    <div>{{ section.settings.text }}</div>
  </div>
</header>
{% schema %}
{
  "name": "Page header",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "text", "label": "Text beside the heading" },
    { "type": "image_picker", "id": "bg", "label": "Background image" }
  ],
  "presets": [{ "name": "Page header" }]
}
{% endschema %}
