{{ 'apparel.css' | asset_url | stylesheet_tag }}
<section class="wrap sec-s" style="padding-bottom:var(--gap)">
  <div class="nd">
    <div class="stack-s">
      <span class="lab"><i></i>{{ section.settings.eyebrow }}</span>
      <h2 class="h2">{{ section.settings.heading }}</h2>
      <p class="copy">{{ section.settings.text }}</p>
    </div>
    <div>
      {%- form 'customer', id: 'dropSignup' -%}
        <input type="hidden" name="contact[tags]" value="newsletter,next-drop">
        <div class="signup">
          <label class="visually-hidden" for="ndEmail">Email address</label>
          <input id="ndEmail" type="email" name="contact[email]" placeholder="Email address" autocomplete="email" required>
          <button type="submit">{{ section.settings.button }}</button>
        </div>
        {%- if form.posted_successfully? -%}<p class="note" role="status">You're on the list for the next drop.</p>{%- endif -%}
        {%- if form.errors -%}<p class="note" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Next drop sign-up",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Next drop" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "First to know" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "New designs land as the show grows. Leave your email and you hear first. Nothing else." },
    { "type": "text", "id": "button", "label": "Button label", "default": "Sign up" }
  ],
  "presets": [{ "name": "Next drop sign-up" }]
}
{% endschema %}
