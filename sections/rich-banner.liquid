{%- comment -%} Network / partner banner: logo beside explanatory text {%- endcomment -%}
<div class="wrap sec" style="padding-bottom:0">
  {%- if section.settings.heading != blank -%}
    <div class="sh"><div class="stack-s"><span class="lab"><i></i>{{ section.settings.eyebrow }}</span><h2 class="bl sm">{{ section.settings.heading }}</h2></div>
    <p class="copy">{{ section.settings.text }}</p></div>
  {%- endif -%}
  {%- for block in section.blocks -%}
    <article class="nb" style="--tint:{{ block.settings.tint }}" {{ block.shopify_attributes }}>
      <div class="lg">{%- if block.settings.logo -%}<img src="{{ block.settings.logo | image_url: width: 600 }}" alt="{{ block.settings.name | escape }}">{%- endif -%}</div>
      <div class="stack-s" style="display:grid;gap:14px">
        <h2 class="h1">{{ block.settings.name }}</h2>
        <p class="big" style="max-width:none">{{ block.settings.tagline }}</p>
        <p class="copy" style="max-width:70ch">{{ block.settings.text }}</p>
        <div class="facts">
          {%- if block.settings.fact1 != blank -%}<span><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="2.5"/><path d="M7 7a7 7 0 0 0 0 10M17 7a7 7 0 0 1 0 10"/></svg>{{ block.settings.fact1 }}</span>{%- endif -%}
          {%- if block.settings.fact2 != blank -%}<span><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s7-6.2 7-11a7 7 0 0 0-14 0c0 4.8 7 11 7 11z"/><circle cx="12" cy="10" r="2.4"/></svg>{{ block.settings.fact2 }}</span>{%- endif -%}
        </div>
        <div class="btns" style="margin-top:6px">
          {%- if block.settings.url != blank -%}<a class="btn solid" href="{{ block.settings.url }}" target="_blank" rel="noopener"><svg class="ic yt" viewBox="0 0 28 20" aria-hidden="true"><rect width="28" height="20" rx="5"/><path d="M11 5.5v9l8-4.5z" fill="#fff"/></svg>{{ block.settings.cta }}</a>{%- endif -%}
          {%- if block.settings.url2 != blank -%}<a class="btn" href="{{ block.settings.url2 }}" target="_blank" rel="noopener">{{ block.settings.cta2 }}</a>{%- endif -%}
        </div>
      </div>
    </article>
  {%- endfor -%}
</div>
{% schema %}
{
  "name": "Network banners",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Where Conflict lives" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The network" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Conflict is one show on an independent network. Here is who is behind it and where to watch." }
  ],
  "blocks": [
    { "type": "show", "name": "Show", "settings": [
      { "type": "image_picker", "id": "logo", "label": "Logo" },
      { "type": "color", "id": "tint", "label": "Tint", "default": "#2a2a2a" },
      { "type": "text", "id": "name", "label": "Name", "default": "Counter Culture Inc" },
      { "type": "text", "id": "tagline", "label": "Tagline", "default": "A direct dose of truth and entertainment, counter to the narrative you have been fed." },
      { "type": "textarea", "id": "text", "label": "Description" },
      { "type": "text", "id": "fact1", "label": "Fact 1", "default": "Live streams and replays" },
      { "type": "text", "id": "fact2", "label": "Fact 2" },
      { "type": "text", "id": "cta", "label": "Button label", "default": "Watch on YouTube" },
      { "type": "url", "id": "url", "label": "Button link" },
      { "type": "text", "id": "cta2", "label": "Second button label", "default": "Subscribe" },
      { "type": "url", "id": "url2", "label": "Second button link" }
    ]}
  ],
  "presets": [{ "name": "Network banners", "blocks": [{"type":"show"},{"type":"show"}] }]
}
{% endschema %}
