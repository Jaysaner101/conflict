<div class="wrap sec">
  <div class="sh"><h2 class="h2">{{ section.settings.heading }}</h2><span class="lab">{{ section.settings.note }}</span></div>
  <ol class="steps">
    {%- for block in section.blocks -%}
      <li {{ block.shopify_attributes }}><b>{{ block.settings.title }}</b>{{ block.settings.text }}</li>
    {%- endfor -%}
  </ol>
</div>
{% schema %}
{
  "name": "Steps",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What happens next" },
    { "type": "text", "id": "note", "label": "Note", "default": "Proof included on every order" }
  ],
  "blocks": [
    { "type": "step", "name": "Step", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Murphy checks the artwork" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "Vector is best: SVG, AI, EPS or PDF. A clean PNG also works." }
    ]}
  ],
  "presets": [{ "name": "Steps", "blocks": [{"type":"step"},{"type":"step"},{"type":"step"},{"type":"step"}] }]
}
{% endschema %}
