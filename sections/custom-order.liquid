<div class="pl ovf" id="tool" {% if section.settings.bg %}style="background-image:url({{ section.settings.bg | image_url: width: 2000 }})"{% endif %}>
  <div class="wrap" style="padding-top:clamp(112px,9.5vw,144px);padding-bottom:var(--gap)">
    <div class="sh" style="margin-bottom:clamp(22px,2.6vw,40px)">
      <div class="stack-s"><span class="lab"><i></i>{{ section.settings.eyebrow }}</span><h1 class="bl md">{{ section.settings.heading }}</h1></div>
      <p class="copy" style="max-width:44ch">{{ section.settings.text }}</p>
    </div>
    <div class="cfg">
      <div class="cfg-stage">
        <div class="cv-w"><canvas id="cv" width="900" height="900" aria-label="Logo preview. Drag to move the logo."></canvas></div>
        <div class="cfg-hint">
          <span class="note">Drag the logo to place it</span>
          <span class="note">Preview only, a real proof follows</span>
        </div>
      </div>
      <div class="cfg-p">
        <div class="cfg-s"><span class="lab"><b>1</b>Choose the piece</span><div class="opts" id="cfgPiece"></div></div>
        <div class="cfg-s"><span class="lab"><b>2</b>Add your logo</span>
          <label class="upl"><input id="logoFile" type="file" accept="image/*">
            <span class="btn" style="min-height:40px;padding:0 18px">Upload</span>
            <span class="note" id="uplName">Black on white or a transparent PNG works best</span></label>
        </div>
        <div class="cfg-s"><span class="lab"><b>3</b>Place it, then fine tune</span>
          <div class="cfg-row">
            <label class="field"><span class="note">Size</span><input class="range" id="logoSize" type="range" min="12" max="90" value="46"></label>
            <label class="field"><span class="note">Rotation</span><input class="range" id="logoRot" type="range" min="-180" max="180" value="0"></label>
          </div>
          <div class="opts"><button class="opt" id="logoInv" aria-pressed="false" type="button">Invert logo</button><button class="opt" id="logoDl" type="button">Download mockup</button></div>
        </div>
        <div class="cfg-s"><span class="lab"><b>4</b>How many</span>
          <div class="cfg-q"><b id="cfgN">48</b><input class="range" id="cfgQty" type="range" min="12" max="500" value="48" aria-label="Quantity"></div>
        </div>
        <div class="cfg-tot">
          <div class="go"><span class="lab">Per piece</span><b id="cfgEach"></b></div>
          <div><span class="lab">Volume price</span><b id="cfgSave"></b></div>
          <div><span class="lab">Total</span><b id="cfgTotal"></b></div>
        </div>
        <div class="cfg-s" style="border-bottom:0">
          <p class="note" id="cfgNote"></p>
          {%- comment -%}
            The reveal button starts hidden and the form starts visible, so the
            form still works with no JavaScript. initCfg flips the pair on load.
          {%- endcomment -%}
          <button class="btn solid full" id="cfgGo" type="button" hidden>Request this quote</button>
          {%- form 'contact', id: 'cfgForm', class: 'stack-s', novalidate: 'novalidate' -%}
            {%- if form.posted_successfully? -%}<span data-posted hidden></span>{%- endif -%}
            <div class="note ink" id="cfgSum"></div>
            <input type="hidden" name="contact[order]" id="cfgOrderField">
            <label class="visually-hidden" for="cfgName">Your name</label>
            <input class="inp" id="cfgName" name="contact[name]" placeholder="Your name" autocomplete="name" required>
            <label class="visually-hidden" for="cfgEmail">Email</label>
            <input class="inp" id="cfgEmail" name="contact[email]" type="email" placeholder="Email" autocomplete="email" required>
            <label class="visually-hidden" for="cfgOrg">Business, team or department</label>
            <input class="inp" id="cfgOrg" name="contact[organisation]" placeholder="Business, team or department" autocomplete="organization">
            <label class="visually-hidden" for="cfgBody">Deadline, placement notes, anything else</label>
            <textarea class="inp" id="cfgBody" name="contact[body]" placeholder="Deadline, placement notes, anything else" style="min-height:84px"></textarea>
            <button class="btn solid full" type="submit">Send to Murphy</button>
            {%- if form.posted_successfully? -%}<span class="note" id="quoteMsg" role="status">Request sent. Murphy replies within 2 business days.</span>
            {%- else -%}<span class="note" id="quoteMsg" role="status"></span>{%- endif -%}
          {%- endform -%}
        </div>
      </div>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Custom order tool",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Custom orders, twelve pieces or more" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Put your logo on it" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Custom designs and logos are for larger orders only: businesses, nonprofits, teams, departments and schools. Upload your logo, place it on the piece and pick a quantity. The price updates as you go, and Murphy sends a real proof before anything is made." },
    { "type": "image_picker", "id": "bg", "label": "Background image" }
  ],
  "presets": [{ "name": "Custom order tool" }]
}
{% endschema %}
