<footer class="foot">
  <div class="wrap foot-top">
    <div class="stack">
      {%- if section.settings.lockup != blank -%}
        <img src="{{ section.settings.lockup | image_url: width: 360 }}" alt="{{ shop.name }}" style="width:120px">
      {%- else -%}
        <img src="{{ 'logo-lockup.webp' | asset_url }}" alt="{{ shop.name }}" style="width:120px">
      {%- endif -%}
      <p class="copy">{{ section.settings.blurb }}</p>
      {% form 'customer' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="signup">
          <input type="email" name="contact[email]" placeholder="Email address" aria-label="Email address" required>
          <button type="submit">Subscribe</button>
        </div>
        {%- if form.posted_successfully? -%}<span class="note" role="status">Thanks. You are on the list.</span>{%- endif -%}
      {% endform %}
      <div class="social">
        {%- for b in section.blocks -%}
          {%- if b.settings.url != blank -%}
            <a class="ib2" href="{{ b.settings.url }}" aria-label="{{ b.settings.name }}" target="_blank" rel="noopener">{{ b.settings.name | slice: 0, 2 }}</a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
    <div class="fcols">
      {%- for i in (1..3) -%}
        {%- assign lk = 'menu_' | append: i -%}
        {%- assign ttl = 'title_' | append: i -%}
        <div>
          <span class="lab">{{ section.settings[ttl] }}</span>
          <ul>{%- for link in section.settings[lk].links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}</ul>
        </div>
      {%- endfor -%}
    </div>
  </div>
  <div class="wrap foot-bot">
    <span class="note">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.place }}</span>
    <a class="built" href="https://ccincstudios.com" target="_blank" rel="noopener"><span>Site by</span><b>Counter Culture Inc Studios</b></a>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "image_picker", "id": "lockup", "label": "Logo lockup" },
    { "type": "text", "id": "blurb", "label": "Sign-up blurb", "default": "New designs, restocks and the apparel release. Occasional, and nothing else." },
    { "type": "text", "id": "place", "label": "Place line", "default": "Omaha, Nebraska." },
    { "type": "text", "id": "title_1", "label": "Column 1 title", "default": "Shop" },
    { "type": "link_list", "id": "menu_1", "label": "Column 1 menu" },
    { "type": "text", "id": "title_2", "label": "Column 2 title", "default": "Orders" },
    { "type": "link_list", "id": "menu_2", "label": "Column 2 menu" },
    { "type": "text", "id": "title_3", "label": "Column 3 title", "default": "About" },
    { "type": "link_list", "id": "menu_3", "label": "Column 3 menu" }
  ],
  "blocks": [
    { "type": "social", "name": "Social link", "settings": [
      { "type": "text", "id": "name", "label": "Name", "default": "Instagram" },
      { "type": "url", "id": "url", "label": "Link" }
    ]}
  ]
}
{% endschema %}
