{%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
<div class="wrap sec-s">
  <div class="ghead">
    <div class="stack-s">
      {%- if section.settings.eyebrow != blank -%}<span class="lab"><i></i>{{ section.settings.eyebrow }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="bl xs">{{ section.settings.heading }}</h2>{%- endif -%}
    </div>
    {%- if section.settings.cta != blank and section.settings.url != blank -%}
      <a class="ul" href="{{ section.settings.url }}">{{ section.settings.cta }}</a>
    {%- endif -%}
  </div>
</div>
{%- endif -%}
<div class="work" style="grid-template-columns:repeat({{ section.blocks.size | at_most: 4 }},1fr)">
  {%- for block in section.blocks -%}
    {%- liquid
      assign clip = block.settings.clip
      if clip != blank
        unless clip contains 'http'
          assign clip = clip | file_url
        endunless
      endif
    -%}
    <div class="wk" style="cursor:default" {{ block.shopify_attributes }}>
      {%- if clip != blank -%}<video src="{{ clip }}" {% if block.settings.image %}poster="{{ block.settings.image | image_url: width: 800 }}"{% endif %} muted loop playsinline></video>
      {%- elsif block.settings.image -%}<img src="{{ block.settings.image | image_url: width: 900 }}" alt="{{ block.settings.alt | escape }}" loading="lazy">{%- endif -%}
    </div>
  {%- endfor -%}
</div>
{% schema %}
{
  "name": "Media strip",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "clip",
          "label": "Video file"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Media strip",
      "blocks": [
        {
          "type": "item"
        },
        {
          "type": "item"
        },
        {
          "type": "item"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "cta",
      "label": "Link label"
    },
    {
      "type": "url",
      "id": "url",
      "label": "Link"
    }
  ]
}
{% endschema %}
