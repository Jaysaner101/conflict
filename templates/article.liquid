<header class="pghd" style="background-image:url({{ 'pl-plain.jpg' | asset_url }})">
  <div class="wrap pghd-in" style="position:relative;z-index:2">
    <div class="stack-s">
      <span class="lab"><i></i>{{ article.published_at | date: '%b %d, %Y' }}</span>
      <h1 class="bl md">{{ article.title }}</h1>
    </div>
    {%- if article.excerpt != blank -%}<div><div class="copy">{{ article.excerpt }}</div></div>{%- endif -%}
  </div>
</header>

<div class="wrap sec">
  {%- if article.image -%}
    <img src="{{ article.image | image_url: width: 1600 }}" alt="{{ article.image.alt | escape }}"
         style="width:100%;height:auto;margin-bottom:34px" width="1600" height="900">
  {%- endif -%}
  <div class="rte copy" style="max-width:72ch">{{ article.content }}</div>

  <div class="btns" style="margin-top:34px"><a class="btn" href="{{ blog.url }}">All posts</a></div>

  {%- if blog.comments_enabled? -%}
    <div class="sec-s" id="comments">
      <h2 class="bl xs">{{ article.comments_count }} comment{% unless article.comments_count == 1 %}s{% endunless %}</h2>
      {%- for comment in article.comments -%}
        <div class="glass" style="margin-top:14px">
          <span class="lab">{{ comment.author }} &middot; {{ comment.created_at | date: '%b %d, %Y' }}</span>
          <p class="copy">{{ comment.content }}</p>
        </div>
      {%- endfor -%}
      {%- form 'new_comment', article -%}
        {%- if form.errors -%}<p class="note">{{ form.errors | default_errors }}</p>{%- endif -%}
        {%- if form.posted_successfully? -%}<p class="note">Thanks. Your comment is awaiting approval.</p>{%- endif -%}
        <div class="field" style="margin-top:18px">
          <label class="lab" for="cAuthor">Name</label>
          <input class="inp" type="text" id="cAuthor" name="comment[author]" required>
        </div>
        <div class="field">
          <label class="lab" for="cEmail">Email</label>
          <input class="inp" type="email" id="cEmail" name="comment[email]" required>
        </div>
        <div class="field">
          <label class="lab" for="cBody">Comment</label>
          <textarea class="inp" id="cBody" name="comment[body]" required></textarea>
        </div>
        <div class="btns"><button class="btn solid" type="submit">Post comment</button></div>
      {%- endform -%}
    </div>
  {%- endif -%}
</div>
