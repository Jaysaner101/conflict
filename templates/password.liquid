{%- layout 'password' -%}
<div class="wrap sec pgtop" style="text-align:center">
  <span class="lab"><i></i>Opening soon</span>
  <h1 class="bl md" style="margin:14px 0">{{ shop.name }}</h1>
  <p class="copy" style="max-width:48ch;margin:0 auto 26px">
    Engraved gear, cut on an industrial fiber laser in Omaha, Nebraska. The store opens shortly.
  </p>

  {%- form 'customer' -%}
    {%- if form.posted_successfully? -%}
      <p class="note">Thanks. We will let you know the moment it opens.</p>
    {%- else -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="field" style="max-width:380px;margin:0 auto">
        <label class="lab" for="pwEmail">Email</label>
        <input class="inp" type="email" id="pwEmail" name="contact[email]" placeholder="you@example.com" required>
      </div>
      <div class="btns" style="justify-content:center;margin-top:14px">
        <button class="btn solid" type="submit">Notify me</button>
      </div>
    {%- endif -%}
  {%- endform -%}

  <div style="margin-top:40px">
    {%- form 'storefront_password' -%}
      {%- if form.errors -%}<p class="note">{{ form.errors | default_errors }}</p>{%- endif -%}
      <div class="field" style="max-width:380px;margin:0 auto">
        <label class="lab" for="pw">Store password</label>
        <input class="inp" type="password" id="pw" name="password" required>
      </div>
      <div class="btns" style="justify-content:center;margin-top:14px">
        <button class="btn" type="submit">Enter</button>
      </div>
    {%- endform -%}
  </div>
</div>
