<div class="wrap sec" style="max-width:520px">
  <span class="lab"><i></i>Account</span>
  <h1 class="bl sm" style="margin:12px 0 22px">Choose a new password</h1>
  {%- form 'reset_customer_password' -%}
    {%- if form.errors -%}<p class="note">{{ form.errors | default_errors }}</p>{%- endif -%}
    <div class="field">
      <label class="lab" for="rsPass">New password</label>
      <input class="inp" type="password" id="rsPass" name="customer[password]" autocomplete="new-password" required>
    </div>
    <div class="field">
      <label class="lab" for="rsConf">Confirm password</label>
      <input class="inp" type="password" id="rsConf" name="customer[password_confirmation]" autocomplete="new-password" required>
    </div>
    <div class="btns"><button class="btn solid" type="submit">Save password</button></div>
  {%- endform -%}
</div>
