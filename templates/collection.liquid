{%- liquid
  assign apparel_count = 0
  for p in collection.products
    if p.tags contains 'apparel'
      assign apparel_count = apparel_count | plus: 1
    endif
  endfor
  assign all_apparel = false
  if apparel_count > 0 and apparel_count == collection.products.size
    assign all_apparel = true
  endif
-%}
<header class="pghd shophd" style="background-image:url({{ 'pl-plain.jpg' | asset_url }})">
  <div class="wrap pghd-in" style="position:relative;z-index:2">
    <div class="stack-s">
      <span class="lab"><i></i>{{ collection.metafields.custom.eyebrow | default: 'Engraved gear and apparel' }}</span>
      <h1 class="bl md">{{ collection.title }}</h1>
    </div>
    <div>
      {%- if collection.description != blank -%}<div class="copy">{{ collection.description }}</div>{%- endif -%}
      <div class="sfacts" style="margin-top:14px">
        {%- if all_apparel -%}
          <span>US shipping {{ settings.fact_apparel_us }}</span>
          <span>Size guide on every piece</span>
        {%- else -%}
          <span>Ships in {{ settings.fact_ship_time | default: 'about 3 days' | downcase }}</span>
          <span>Add a name, $5</span>
          <span>US shipping {{ settings.fact_ship_us }}</span>
        {%- endif -%}
      </div>
    </div>
  </div>
</header>

{%- paginate collection.products by 24 -%}
<div class="wrap sec-s" style="padding-bottom:var(--gap)">
  <div class="chips" role="group" aria-label="Collections">
    <a class="chip{% if collection.handle == 'all' %} on{% endif %}" href="{{ routes.all_products_collection_url }}">All</a>
    {%- for c in collections -%}
      {%- if c.handle == 'frontpage' or c.handle == 'all' -%}{%- continue -%}{%- endif -%}
      {%- unless c.handle == 'all' or c.products_count == 0 -%}
        <a class="chip{% if c.handle == collection.handle %} on{% endif %}" href="{{ c.url }}">{{ c.title }}</a>
      {%- endunless -%}
    {%- endfor -%}
  </div>
  {%- liquid
    assign types = ''
    for pr in collection.products
      if pr.type != blank
        assign types = types | append: pr.type | append: '|'
      endif
    endfor
    assign types = types | split: '|' | uniq
  -%}
  {%- if collection.handle != 'all' and types.size > 1 -%}
    <div class="chips tchips" id="typeChips" role="group" aria-label="Filter by type">
      <button type="button" class="chip" data-type="all" aria-pressed="true">All</button>
      {%- for t in types -%}
        <button type="button" class="chip" data-type="{{ t | handleize }}" aria-pressed="false">{{ t }}</button>
      {%- endfor -%}
    </div>
  {%- endif -%}
  <div class="shopbar">
    <span class="lab" id="countLab">{{ collection.products_count }} {% if collection.products_count == 1 %}piece{% else %}pieces{% endif %}</span>
    {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
    <form method="get" action="{{ collection.url }}" id="sortForm">
      {%- if collection.current_type != blank -%}<input type="hidden" name="q" value="{{ collection.current_type }}">{%- endif -%}
      <label class="sortw">
        <span class="lab">Sort</span>
        <select id="sort" name="sort_by" aria-label="Sort products">
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>
          {%- endfor -%}
        </select>
      </label>
      <noscript><button class="btn" type="submit">Sort</button></noscript>
    </form>
  </div>
  <div class="grid">
    {%- for product in collection.products -%}
      {%- render 'product-card', card_product: product -%}
    {%- else -%}
      <p class="copy">No products in this collection yet.</p>
    {%- endfor -%}
  </div>
  {%- if paginate.pages > 1 -%}<div class="btns">{{ paginate | default_pagination }}</div>{%- endif -%}
</div>
{%- endpaginate -%}
