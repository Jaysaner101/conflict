{%- comment -%}
  Engraved products. Apparel has its own template (product.apparel). An apparel
  product that has not been given that template yet still gets the apparel
  page, so it can never show engraving copy or the name add-on.
{%- endcomment -%}
{%- if product.tags contains 'apparel' -%}
  {%- section 'apparel-product' -%}
{%- else -%}
<div style="padding-top:clamp(112px,9.5vw,144px)" id="pdp">
  <div class="wrap">
    <div class="pdp">
      <div>
        {%- comment -%}
          Every photo is in the page. Desktop shows one at a time (thumbnails
          switch them); phones and tablets swipe through them. theme.js initGallery.
        {%- endcomment -%}
        {%- assign pics = product.media | where: 'media_type', 'image' -%}
        <div class="pgal">
          <div class="stage pgal-main" id="pStage">
            {%- for m in pics -%}
              <img class="ph pgal-s{% if forloop.first %} on{% endif %}" src="{{ m | image_url: width: 1400 }}"
                   srcset="{{ m | image_url: width: 700 }} 700w, {{ m | image_url: width: 1100 }} 1100w, {{ m | image_url: width: 1400 }} 1400w"
                   sizes="(max-width: 1020px) 100vw, 50vw" alt="{{ m.alt | default: product.title | escape }}" width="1400" height="1400"
                   {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}>
            {%- endfor -%}
          </div>
          {%- if pics.size > 1 -%}<span class="pgal-n" id="pGalN" aria-hidden="true">1 / {{ pics.size }}</span>{%- endif -%}
        </div>
        {%- if pics.size > 1 -%}
          <div class="thumbs">
            {%- for m in pics -%}
              <button class="thumb" type="button" aria-label="View image {{ forloop.index }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}">
                <img src="{{ m | image_url: width: 200 }}" alt="" width="84" height="84" loading="lazy">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
        <dl class="spec">
          <div><dt class="lab">Material</dt><dd>{{ product.metafields.custom.material | default: product.type | default: 'To be confirmed' }}</dd></div>
          <div><dt class="lab">Engraving</dt><dd>Industrial fiber laser. Deep and permanent</dd></div>
          <div><dt class="lab">Made in</dt><dd>Omaha, Nebraska</dd></div>
          <div><dt class="lab">Shipping time</dt><dd>About 3 days. About a week with a name</dd></div>
        </dl>
      </div>

      <div class="buy stack">
        <nav class="lab"><a class="ul" href="{{ routes.all_products_collection_url }}">Shop</a> / {{ product.type | default: 'Engraved' }}</nav>
        <h1 class="bl sm">{{ product.title }}</h1>
        <div class="lab">{{ product.metafields.custom.material | default: product.type }}</div>
        <div class="price" id="pPrice">{{ product.price | money_without_trailing_zeros }}</div>
        <div class="copy">{{ product.description }}</div>

        {%- form 'product', product, id: 'buyForm' -%}
          {%- unless product.has_only_default_variant -%}
            {%- for opt in product.options_with_values -%}
              <div class="field">
                <span class="note">{{ opt.name }}</span>
                <div class="opts">
                  {%- for v in opt.values -%}
                    <button class="opt" type="button" data-opt="{{ opt.position }}" data-val="{{ v | escape }}"
                      aria-pressed="{% if opt.selected_value == v %}true{% else %}false{% endif %}">{{ v }}</button>
                  {%- endfor -%}
                </div>
              </div>
            {%- endfor -%}
          {%- endunless -%}

          <label class="visually-hidden" for="variantSelect">Choose an option</label>
          <select name="id" id="variantSelect" hidden>
            {%- for v in product.variants -%}
              <option value="{{ v.id }}" {% if v == product.selected_or_first_available_variant %}selected{% endif %} {% unless v.available %}disabled{% endunless %}>{{ v.title }} — {{ v.price | money }}</option>
            {%- endfor -%}
          </select>

          <div class="acc">
              <label class="acc-h">
                {%- assign addon = all_products['name-engraving'] -%}
                <input type="checkbox" id="addName" data-base="{{ product.price | divided_by: 100.0 }}"
                       data-add="{% if addon.first_available_variant %}{{ addon.price | divided_by: 100.0 }}{% else %}5{% endif %}"
                       {% if addon.first_available_variant %}data-addon-variant="{{ addon.first_available_variant.id }}"{% endif %}>
                <span>Add a name <b>+ $5</b></span>
              </label>
              <div id="nameWrap" hidden>
                <label class="visually-hidden" for="nameIn">Name to engrave</label>
                <input class="inp" id="nameIn" name="properties[Name to engrave]" maxlength="18" placeholder="Name, call sign or number">
                <span class="note">Engraved to match the piece. Named items take about a week.</span>
              </div>
            </div>

          <button class="btn solid full" type="submit" {% unless product.available %}disabled{% endunless %}>
            {% if product.available %}Add to cart{% else %}Sold out{% endif %}
          </button>
          {%- comment -%} Shop Pay / Apple Pay / Google Pay. Hidden while "Add a name" is ticked: the name is a separate $5 line that express checkout would skip (theme.js initNameOption). {%- endcomment -%}
          {%- if product.available -%}<div class="xpay" id="xpay">{{ form | payment_button }}</div>{%- endif -%}
        {%- endform -%}

        <p class="note">Ships in {{ settings.fact_ship_time | default: 'about 3 days' | downcase }}. US shipping {{ settings.fact_ship_us | default: '$4.99' }}. Canada {{ settings.fact_ca | downcase }}.</p>

        <a class="ul" href="/pages/custom-and-bulk">Need twelve or more with your logo? Custom orders</a>
      </div>
    </div>
  </div>

  <div class="wrap sec">
    <div class="sh"><h2 class="h2">More in stock</h2><a class="ul" href="{{ routes.all_products_collection_url }}">View all</a></div>
    <div class="grid">
      {%- assign rel = collections[product.collections.first.handle].products | default: collections.all.products -%}
      {%- assign n = 0 -%}
      {%- for p in rel -%}
        {%- if p.id != product.id and n < 4 -%}{%- render 'product-card', card_product: p -%}{%- assign n = n | plus: 1 -%}{%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{%- endif -%}
