<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop.name }}</title>
  {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  <meta name="theme-color" content="{{ settings.col_bg }}">
  <link rel="icon" href="{% if settings.favicon != blank %}{{ settings.favicon | image_url: width: 64 }}{% else %}{{ 'favicon.png' | asset_url }}{% endif %}">
  <link rel="stylesheet" href="{{ 'base.css' | asset_url }}">
  <style>
    :root{
      --bg:{{ settings.col_bg }}; --ink:{{ settings.col_ink }}; --body:{{ settings.col_body }};
      --hi:{{ settings.col_hi }}; --s1:{{ settings.col_s1 }};
    }
    /* The store is locked, so this page carries no shop navigation —
       every link would only bounce the visitor back to the password gate. */
    .pw-head{padding:clamp(28px,5vw,56px) 0 0;text-align:center}
    .pw-head img{width:clamp(120px,16vw,190px);height:auto}
  </style>
  {{ content_for_header }}
</head>
<body>
  <div class="pw-head"><img src="{{ 'logo-lockup.webp' | asset_url }}" alt="{{ shop.name }}" width="190" height="90"></div>
  <main id="main">
    {{ content_for_layout }}
  </main>
</body>
</html>
