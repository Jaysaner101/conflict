<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ page_title }}{% unless page_title contains shop.name %} | {{ shop.name }}{% endunless %}</title>
  {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  <link rel="canonical" href="{{ canonical_url }}">
  <meta name="theme-color" content="{{ settings.col_bg }}">
  {% if settings.favicon %}<link rel="icon" href="{{ settings.favicon | image_url: width: 64 }}">{% endif %}
  <link rel="preload" href="{{ 'mona-sans.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="{{ 'base.css' | asset_url }}">
  <style>
    :root{
      --bg:{{ settings.col_bg }}; --ink:{{ settings.col_ink }}; --body:{{ settings.col_body }};
      --hi:{{ settings.col_hi }}; --s1:{{ settings.col_s1 }};
    }
  </style>
  {{ content_for_header }}
</head>
<body class="tpl-{{ template.name }}" data-page="{{ template.name }}">
  <a class="skip" href="#main">Skip to content</a>
  {% section 'header' %}
  <main id="main">
    {{ content_for_layout }}
  </main>
  {% section 'footer' %}
  <script src="{{ 'theme.js' | asset_url }}" defer></script>
</body>
</html>
