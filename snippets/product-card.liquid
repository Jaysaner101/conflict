{%- comment -%}
  Product card, used on every grid. One hover rule for every product: the card
  shows the product's second photo (for apparel, the other side of the shirt),
  and a product with one photo just eases in. Nothing is printed over the photos.
{%- endcomment -%}
{%- liquid
  assign p = card_product
  assign is_apparel = false
  if p.tags contains 'apparel'
    assign is_apparel = true
  endif
  assign colours = nil
  assign sizes = nil
  for o in p.options_with_values
    assign on = o.name | downcase
    if on contains 'colo'
      assign colours = o.values
    elsif on contains 'size'
      assign sizes = o.values
    endif
  endfor
  comment
    The hover photo: a photo described as the back if there is one (apparel),
    otherwise the first later photo that isn't another colour's main photo,
    so hovering never just shows a different colour of the same front.
  endcomment
  assign colour_fronts = ''
  for v in p.variants
    if v.featured_media
      assign colour_fronts = colour_fronts | append: '|' | append: v.featured_media.id | append: '|'
    endif
  endfor
  assign second = nil
  for m in p.media offset: 1
    if m.media_type == 'image'
      assign alt_text = m.alt | downcase
      if alt_text contains 'back'
        assign second = m
        break
      endif
    endif
  endfor
  if second == nil
    for m in p.media offset: 1
      assign key = '|' | append: m.id | append: '|'
      if m.media_type == 'image' and colour_fronts contains key
        continue
      endif
      if m.media_type == 'image'
        assign second = m
        break
      endif
    endfor
  endif
-%}
<a class="card{% if second %} has-alt{% endif %}{% if is_apparel %} ap{% endif %}" href="{{ p.url }}" data-type="{{ p.type | handleize }}">
  <div class="stage">
    {%- if p.featured_media -%}
      <img class="ph" src="{{ p.featured_media | image_url: width: 900 }}" alt="{{ p.featured_media.alt | default: p.title | escape }}" loading="lazy" width="450" height="450">
      {%- if second -%}
        <img class="ph alt" src="{{ second | image_url: width: 900 }}" alt="" loading="lazy" width="450" height="450">
      {%- endif -%}
    {%- endif -%}
  </div>
  <div class="meta">
    <div>
      <div class="n">{{ p.title }}</div>
      <div class="m">
        {%- if is_apparel -%}
          {%- if colours and colours.size > 1 -%}{{ colours.size }} colours{%- elsif colours -%}{{ colours.first }}{%- endif -%}
          {%- if colours and sizes %}, {% endif -%}
          {%- if sizes -%}{{ sizes.first }} to {{ sizes.last }}{%- endif -%}
          {%- unless colours or sizes -%}{{ p.type }}{%- endunless -%}
        {%- else -%}
          {{ p.metafields.custom.material | default: p.type }}{% if p.tags contains 'ships-free' %}, ships free{% endif %}
        {%- endif -%}
      </div>
      {%- if colours and colours.size > 1 -%}
        <div class="dots" aria-hidden="true">
          {%- for c in colours limit: 8 -%}<i style="{% render 'colour-swatch', name: c %}"></i>{%- endfor -%}
          {%- if colours.size > 8 -%}<em>+{{ colours.size | minus: 8 }}</em>{%- endif -%}
        </div>
      {%- endif -%}
    </div>
    <div class="p">{% if p.price_varies %}From {% endif %}{{ p.price | money_without_trailing_zeros }}</div>
  </div>
</a>
